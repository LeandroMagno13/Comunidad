generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                    @id @default(cuid())
  email                      String                    @unique
  password                   String
  name                       String
  role                       String                    @default("USER")
  status                     String                    @default("active")
  lastLoginAt                DateTime?
  avatarUrl                  String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  profile                    Profile?
  skills                     Skill[]
  categories                 Category[]
  guildMemberships           GuildMembership[]
  guildsCreated              Guild[]                   @relation("GuildCreator")
  contributions              Contribution[]
  interests                  Interest[]
  conversationsAsParticipant ConversationParticipant[]
  sentMessages               Message[]
  posts                      Post[]
  comments                   Comment[]
  notifications              Notification[]
  reports                    Report[]
  adminNotes                 AdminNote[]
  contributedProjects        Project[]
  discussions                Discussion[]
  replies                    Reply[]
  cuAccount                  CuAccount?
  cuTransactionsSent         CuTransaction[] @relation("CuFromUser")
  cuTransactionsReceived     CuTransaction[] @relation("CuToUser")
  postsModerated             Post[]          @relation("PostFulfiller")
  cuAccessLevel              String          @default("basic") // básico | medio | avanzado (asignación, no jerarquía)
  urgencyBudgetRemaining     Int             @default(0) // presupuesto de urgencia restante del período (RONDA D)
  urgencyBudgetPeriod        String          @default("") // clave de período en que se asignó (no acumulable entre períodos)
  createdPolls               Poll[]          @relation("PollCreator")
  pollVotes                  PollVote[]      @relation("PollVoter")
  userCapacities             UserCapacity[]
  capacityRequestsAsker      CapacityRequest[] @relation("CapacityRequestAsker")
  capacityRequestsProvider   CapacityRequest[] @relation("CapacityRequestProvider")
  participationEvents        ParticipationEvent[]
  // ---- Membrana de integraci�n (RONDA F): agentes externos, aditivo, no afecta C/D/E ----
  agents                     Agent[]         @relation("AgentOwner")
  agentActionLogs            AgentActionLog[] @relation("AgentActionOwner")
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  profession   String?
  country      String?
  bio          String?
  expertise    String[]
  interests    String[]
  availability String?
  linkedinUrl  String?
  githubUrl    String?
  websiteUrl   String?
  status       String   @default("registered")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Skill {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  category    String?
  level       String?
  users       User[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?
  users       User[]
  interests   Interest[]
}

model Guild {
  id          String            @id @default(cuid())
  name        String
  description String
  purpose     String?
  creatorId   String?
  status      String            @default("active")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  creator     User?             @relation("GuildCreator", fields: [creatorId], references: [id])
  members     GuildMembership[]
  projects    Project[]
  discussions Discussion[]
  posts       Post[]
  polls       Poll[]
}

model GuildMembership {
  id               String   @id @default(cuid())
  userId           String
  guildId          String
  role             String   @default("member")
  status           String   @default("pending")
  isRepresentative Boolean  @default(false) // representante elegido entre los miembros (gestión de gremios)
  joinedAt         DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
  guild            Guild    @relation(fields: [guildId], references: [id])

  @@unique([userId, guildId])
}

model Project {
  id               String   @id @default(cuid())
  title            String
  description      String
  objectives       String?
  status           String   @default("investigation")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  contributors     User[]
  responsibilities Json?
  guilds           Guild[]
  tasks            Task[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String
  status      String    @default("pending")
  assignedTo  String?
  dueDate     DateTime?
  priority    String    @default("medium")
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id])
}

model Discussion {
  id        String   @id @default(cuid())
  title     String
  content   String
  guildId   String?
  authorId  String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild?   @relation(fields: [guildId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
  replies   Reply[]
}

model Reply {
  id           String     @id @default(cuid())
  content      String
  discussionId String
  authorId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  discussion   Discussion @relation(fields: [discussionId], references: [id])
  author       User       @relation(fields: [authorId], references: [id])
}

model Contribution {
  id          String   @id @default(cuid())
  userId      String
  type        String
  description String
  value       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Interest {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  level      String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId])
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}

model Post {
  id             String    @id @default(cuid())
  authorId       String
  guildId        String?
  title          String?
  content        String
  type           String    @default("update")
  cuOffer        Int?
  requestStatus  String?
  fulfillUserId  String?
  status         String    @default("visible")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  author         User     @relation(fields: [authorId], references: [id])
  guild          Guild?   @relation(fields: [guildId], references: [id])
  fulfilledBy    User?    @relation("PostFulfiller", fields: [fulfillUserId], references: [id])
  comments       Comment[]
  reports        Report[]
  participationEvents ParticipationEvent[]
  polls          Poll[]
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  status    String    @default("visible")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  reports   Report[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Report {
  id           String   @id @default(cuid())
  reportedById String
  postId       String?
  commentId    String?
  reason       String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  reporter     User     @relation(fields: [reportedById], references: [id])
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

// ============ ECONOMÍA CU (experimental, Capa 2) ============
// Un CU es una unidad interna de participación/"stamina".
// No es dinero, no tiene conversión monetaria y no representa patrimonio.

model CuAccount {
  id                 String   @id @default(cuid())
  userId             String   @unique
  balance            Int      @default(0)
  totalIssued        Int      @default(0)
  totalConsumed      Int      @default(0)
  liberationEstimate Int? // estimación del usuario: CU que cree que deberían "liberar" capital real (promediada por la comunidad)
  milestoneReachedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
}

model CuTransaction {
  id          String    @id @default(cuid())
  type        String // issued | transfer | consume | adjustment
  amount      Int // siempre > 0; el signo depende de type y de los flujos
  fromUserId  String?
  toUserId    String?
  description String?
  refType     String? // request, system, ...
  refId       String?
  createdAt   DateTime  @default(now())
  fromUser    User?     @relation("CuFromUser", fields: [fromUserId], references: [id])
  toUser      User?     @relation("CuToUser", fields: [toUserId], references: [id])
}

// Canasta representativa = SET POINT contra el cual se compara el estado real.
model CuBasket {
  id          String          @id @default(cuid())
  name        String
  description String?
  targetCu    Int             @default(100) // set point
  observedCu  Int             @default(100) // valor observado (editable en la etapa de simulación)
  observedMethod String       @default("manual") // metodología para calcular el observado: manual | auto (TODO parametrizable)
  periodDays  Int             @default(30)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       CuBasketItem[]
}

model CuBasketItem {
  id          String   @id @default(cuid())
  basketId    String
  name        String
  weight      Float    @default(1)
  description String?
  basket      CuBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
}

// Configuración del controlador PID y políticas de la economía CU (fila única: id="singleton")
model CuConfig {
  id                 String  @id @default("singleton")
  kp                 Float   @default(0.5)
  ki                 Float   @default(0.1)
  kd                 Float   @default(0.05)
  outputMin          Float   @default(-100)
  outputMax          Float   @default(100)
  periodDays         Int     @default(30)
  milestoneCu        Int     @default(100) // aviso de meta al alcanzar este saldo
  newUserGrantEnabled Boolean @default(true) // política de bienvenida (simulación)
  newUserGrantCu     Int     @default(20) // cantidad base en equilibrio (0 = sin base)
  newUserSensitivity Float   @default(1) // qué tan fuerte baja/sube la asignación según escasez/abundancia
  // Capa SupplyPolicy: la señal PID NO es emisión. La política decide.
  expansionGain      Float   @default(1) // apertura de la válvula de expansión (0 = la política no emite automáticamente)
  contractionGain    Float   @default(1) // apertura de la válvula de contracción (quema proporcional ante abundancia)
  reserveShare       Float   @default(0.3) // proporción de emisión destinada a reserva
  newUserShare       Float   @default(0.5) // proporción destinada a nuevos usuarios
  historicalShare    Float   @default(0.2) // proporción destinada a usuarios históricos (sujeta a ajuste auditable)
  maxEmissionPerCycle Int   @default(1000) // límite anti-shock de emisión absoluto por ciclo
  maxBurnPerCycle    Int     @default(200) // límite anti-shock de contracción (quema) por ciclo
  // Sensor y variable de control (v2): control REAL por acceso a la canasta.
  accessTarget       Float   @default(0.5) // fracción objetivo de cuentas que acceden a la canasta
  reachableSetPoint  Boolean @default(true) // set point efectivo anclado a la distribución (alcanzable)
  sensorFlowGain     Float   @default(0.5) // sensibilidad del sensor al flujo neto (consumo − emisión)/oferta
  sensorAccessGain   Float   @default(0.6) // sensibilidad del sensor a la brecha acceso-objetivo
  // Ajustes históricos: SIEMPRE gratuitas, registradas y auditablemente separadas del PID.
  adjustmentEnabled  Boolean @default(false) // deshabilitado por defecto: no hay reglas de confiscación automática
  adjustmentMode     String  @default("none") // none | flat | proportional | manual
  adjustmentCap      Int     @default(0) // si > 0, límite de |CU| por ajuste por usuario y por evento
  enabled            Boolean @default(true) // si el control de lazo cerrado está activo
  // Capa señalización y capacidad (RONDA C, §Lee.txt). El PID NO gobierna la oferta (pidGoverning=false).
  pidGoverning       Boolean @default(false) // si true, la señal del PID alimenta la política de emisión (solo experimental)
  patrimonyUsd       Float   @default(1000) // patrimonio real simulado (usd), separado de CU
  distributableRate  Float   @default(0.2) // fracción del patrimonio real que las reglas permiten distribuir efectivamente
  grantCap           Int     @default(30) // tope de balance de CU por cuenta (anti-farming)
  urgencyBudgetBase    Int     @default(3) // RONDA D: puntos de urgencia por período (semanal), fijos y no acumulables
  urgencyBudgetMaxLevel Int    @default(3) // RONDA D: intensidad de urgencia máxima marcable (costo cuadrático)
  urgencyBudgetPeriodDays Int  @default(7) // RONDA D: días de cada período de presupuesto de urgencia
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============ CAPACIDADES HUMANAS (RONDA C, §Lee.txt) ============
// Señalización y asignación de capacidad humana. Las CU expresan participación
// y prioridad; nunca convierten a dinero ni a patrimonio.

model Capacity {
  id            String         @id @default(cuid())
  slug          String         @unique // identificador estable (ej: salud-y-cuidado)
  name          String
  description   String?
  category      String?
  automatizacion Float         @default(0) // cobertura tecnológica estimada (0-1)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         UserCapacity[]
  requests      CapacityRequest[]
}

model UserCapacity {
  id            String   @id @default(cuid())
  userId        String
  capacityId    String
  disponibilidad Float   @default(0.5) // declarada 0-1
  calidad       Float    @default(0.5) // declarada 0-1
  verified      Boolean  @default(false) // oferta efectiva ≠ declarada: requiere verificación
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  capacity      Capacity @relation(fields: [capacityId], references: [id])

  @@unique([userId, capacityId])
  @@index([capacityId])
}

model CapacityRequest {
  id            String    @id @default(cuid())
  askerId       String
  capacityId    String
  providerId    String?
  intensity     Int       @default(1)
  cuCommitted   Int       @default(0) // LEGACY (RONDA A/C): quedó en 0 — las CU ya no compran prioridad (se transfiere al proveedor SIEMPRE que se satisfaga). No es precio (§Lee.txt)
  status        String    @default("registered") // registered | satisfied | expired | cancelled
  holdCycles    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  satisfiedAt   DateTime?
  urgencyLevel  Int       @default(0) // RONDA D: intensidad de urgencia marcada (costo cuadrático 1→1, 2→4, 3→9)
  urgencyCost   Int       @default(0) // RONDA D: puntos de urgencia consumidos del presupuesto del período
  expiresAt     DateTime? // fin de la ventana de demanda vigente (§6 Lee.txt, Test D)
  closedAt      DateTime? // momento de expirar/cancelar (auditoría)
  closedReason  String?   // motivo de cierre: auto-expiración, cancelación, etc.
  asker         User      @relation("CapacityRequestAsker", fields: [askerId], references: [id])
  provider      User?     @relation("CapacityRequestProvider", fields: [providerId], references: [id])
  capacity      Capacity  @relation(fields: [capacityId], references: [id])

  @@index([capacityId, status])
  @@index([askerId])
  @@index([providerId])
}

// Eventos de participación (no monetarios): registro de contribución REAL
// cuando alguien satisface una solicitud comunitaria (p. ej. el flujo legacy
// de posts/[id]/offer.ts). NO reemplaza a la CU como unidad de cuenta.
model ParticipationEvent {
  id        String   @id @default(cuid())
  postId    String
  participantId String
  kind      String   @default("fulfillment") // fulfillment | contribution | ...
  detail    String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  participant User   @relation(fields: [participantId], references: [id])

  @@index([participantId])
  @@index([postId])
}

// ============================================================================
// ENCUESTAS (gremiales y comunitarias) con trazabilidad — §Lee.txt (herramientas
// de gestión de gremios). Resultados registrados y consultables: cada voto
// queda como registro inmutable (usuario + opción + timestamp).
// ============================================================================

model Poll {
  id          String      @id @default(cuid())
  title       String
  description String?
  scope       String      @default("guild") // guild | community
  guildId     String?
  postId      String? // enlace a la publicación referida (opcional)
  createdById String
  isClosed    Boolean     @default(false)
  closesAt    DateTime? // cierre temporal (modo temporal): se cierra sola al vencer el tiempo
  createdAt   DateTime    @default(now())

  options PollOption[]
  votes   PollVote[]

  guild     Guild? @relation(fields: [guildId], references: [id], onDelete: SetNull)
  post      Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdBy User   @relation("PollCreator", fields: [createdById], references: [id])
}

model PollOption {
  id     String      @id @default(cuid())
  pollId String
  text   String
  poll   Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation("PollVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId]) // un voto por usuario por encuesta (trazabilidad íntegra)
}

// =====================================================================
// RONDA F - MEMBRANA DE INTEGRACI?N (agentes externos + API p?blica)
// Aditivo. No toca ninguna relaci?n/modelo de Rondas C, D ni E.
// ---------------------------------------------------------------------
// Reglas de la membrana (Lee.txt �2, �5, �6, �8, �9, �10, �14, �16):
//   - El agente NUNCA escala a SUPER_ADMIN: el motor verifica y rechaza
//     cualquier intento de permiso SUPER_ADMIN al crear/editar el agente.
//   - INTERNAL (interfaz interna, gestionada por c?digo propio) vs
//     EXTERNAL (creada por el usuario v?a UI/API): la API p?blica de
//     agentes solo ve EXTERNAL; la interfaz interna solo ve INTERNAL.
//   - Tokens guardados como hash (nunca en claro); se muestran UNA sola
//     vez al crear. Revocable de inmediato (valida contra DB en cada req).
//   - Cada acci?n se registra con trazabilidad: user_id + agent_id +
//     acci?n + fecha + ip (AgentActionLog).
//   - La API p?blica (/api/v1/public/*) es READ-ONLY.
// =====================================================================

model Agent {
  id          String             @id @default(cuid())
  name        String
  description String?
  kind        String             @default("EXTERNAL") // EXTERNAL | INTERNAL (membrana)
  status      String             @default("active")   // active | revoked | blocked
  revokedAt   DateTime?
  blockedAt   DateTime?
  blockedReason String?
  permissions String[]           // permisos granulares concedidos (ej: ["READ_POSTS","WRITE_POSTS"])
  rateLimitPerMinute Int         @default(30) // l?mite de solicitudes/min por token (configurable por agente)
  lastUsedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  owner       User               @relation("AgentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  tokens      AgentToken[]
  actionLogs  AgentActionLog[]

  @@index([ownerId, status])
}

model AgentToken {
  id         String    @id @default(cuid())
  name       String?
  hash       String    @unique // sha256 del token en claro; nunca se guarda el token
  prefix     String // primeros 8 caracteres visibles en la UI (identificaci?n sin exponer secreto)
  agentId    String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
  @@index([agentId])
}

model AgentActionLog {
  id         String   @id @default(cuid())
  userId     String // operador real: el humano al que pertenece el agente
  agentId    String
  action     String // p.ej. "public.api.read", "agent.posts.create"
  endpoint   String
  method     String
  statusCode Int
  ip         String?
  extra      String? // payload resumido/saneado (metadatos, no secretos)
  createdAt  DateTime @default(now())
  user       User     @relation("AgentActionOwner", fields: [userId], references: [id], onDelete: Cascade)
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
}

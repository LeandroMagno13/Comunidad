generator client {
  provider = "prisma-client-js"
}

 datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

 model User {
  id         String      @id @default(cuid())
  email      String      @unique
  password   String
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  profile    Profile?
  skills     Skill[]
  categories Category[]
  guildMemberships GuildMembership[]
  contributions Contribution[]
}

 model Profile {
  id           String     @id @default(cuid())
  userId       String     @unique
  profession   String?
  country      String?
  bio          String?
  expertise    String[]
  interests    String[]
  availability String?
  linkedinUrl  String?
  githubUrl    String?
  websiteUrl   String?
  status       String     @default("registered")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id])
}

 model Skill {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  level       String?
  users       User[]
}

 model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?
  users       User[]
}

 model Guild {
  id          String         @id @default(cuid())
  name        String
  description String
  purpose     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     GuildMembership[]
  projects    Project[]
  discussions Discussion[]
}

 model GuildMembership {
  id       String   @id @default(cuid())
  userId   String
  guildId  String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  guild    Guild    @relation(fields: [guildId], references: [id])

  @@unique([userId, guildId])
}

 model Project {
  id           String     @id @default(cuid())
  title        String
  description  String
  objectives   String?
  status       String     @default("investigation")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contributors User[]
  responsibilities Json?
  guilds       Guild[]    @relation(fields: [guildIds], references: [id])
  guildIds     String[]
}

 model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  status      String     @default("pending")
  assignedTo  String?
  dueDate     DateTime?
  priority    String     @default("medium")
  projectId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  project     Project    @relation(fields: [projectId], references: [id])
}

 model Discussion {
  id          String    @id @default(cuid())
  title       String
    content     String
  guildId     String?
  authorId    String
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  guild       Guild?    @relation(fields: [guildId], references: [id])
  author      User      @relation(fields: [authorId], references: [id])
  replies     Reply[]
}

 model Reply {
  id            String   @id @default(cuid())
  content       String
  discussionId  String
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  discussion    Discussion @relation(fields: [discussionId], references: [id])
  author        User      @relation(fields: [authorId], references: [id])
}

 model Contribution {
  id          String   @id @default(cuid())
  userId      String
  type        String
  description String
  value       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

 model Interest {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  level       String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId])
}

 model AdminNote {
  id         String   @id @default(cuid())
  userId     String
  content    String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}
